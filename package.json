{
  "name": "thoughost-web-renew",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "build": "npm run typecheck && vite build",
    "admin:typecheck": "tsc --noEmit -p admin/tsconfig.json",
    "admin:build": "vite build --config admin/vite.config.ts",
    "admin:start": "node admin/server/main.ts",
    "admin:test": "node --test admin/tests/*.node.ts",
    "admin:init": "node admin/init-local.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-jp": "^5.3.0",
    "colorthief": "^3.5.0",
    "lucide-react": "^1.42.0",
    "motion": "13.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router": "7.18.3",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "7.0.2",
    "vite": "8.0.14",
    "vitest": "5.0.0"
  }
}
